{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      "phoenix-colocated/*": ["./types/phoenix-colocated.d.ts"]
    }
  },
  "include": ["js/**/*", "types/**/*", "vite.config.mjs", "vitest.config.mjs"]
}
